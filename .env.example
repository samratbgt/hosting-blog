# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=HostingHub

# Email Service (Optional - for newsletter integration)
# MAILCHIMP_API_KEY=your_mailchimp_api_key
# MAILCHIMP_LIST_ID=your_list_id

# Analytics (Optional)
# GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
# GOOGLE_TAG_MANAGER_ID=GTM_ID

# Database (Optional - for click tracking)
# DATABASE_URL=your_database_connection_string

# API Keys (Optional - for external services)
# AFFILIATE_API_KEY=your_affiliate_network_api_key
